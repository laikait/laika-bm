{
    "name": "laikait/laika-bm",
    "description": "Laika Bill Manager - billing, provisioning and support for the Laika PHP Framework",
    "type": "package",
    "license": "MIT",
    "authors": [
        {
            "name": "Laika IT",
            "email": "strblackhawk@gmail.com"
        },
        {
            "name": "Showket Ahmed",
            "email": "riyadhtayf@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "autoload": {
        "files": [
            "helpers/loader.php"
        ],
        "psr-4": {
            "LBM\\": "src/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "laika": {
            "resources": {
                "relays": {
                    "path": "src/Relay",
                    "namespace": "LBM\\Relay",
                    "contract": "Laika\\Relay\\RelayProvider"
                }
            }
        }
    }
}
