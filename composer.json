{
    "name": "laikait/laika-bm",
    "type": "package",
    "autoload": {
        "psr-4": {
            "LBM\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Laika IT",
            "email": "strblackhawk@gmail.com"
        },
        {
            "name": "Showket Ahmed",
            "email": "riyadhtayf@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "require": {},
    "extra": {
        "laika": {
            "resources": {
                "routes": {
                    "path": "helpers/Routes"
                },
                "functions": {
                    "path": "helpers/functions"
                },
                "hooks": {
                    "path": "helpers/hooks"
                },
                "models": {
                    "path": "src/Model",
                    "namespace": "LBM\\Model"
                },
                "schemas": {
                    "path": "src/Schema",
                    "namespace": "LBM\\Schema",
                    "contract": "Laika\\Model\\Contract\\SchemaAbstract"
                }
            }
        }
    }
}
